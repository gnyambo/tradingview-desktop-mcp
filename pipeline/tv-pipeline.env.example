# Copy to /etc/tv-pipeline.env and chmod 600 (it holds the bot token).
# systemd does not allow comments on the same line as a value.

# Full path from: which claude
CLAUDE_BIN=/full/path/to/claude
# Same bot and chat the scanner uses
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TV_SCANNER_DB=/opt/binance-futures-scanner/scanner_history.db
TV_PLANS_DIR=/root/tv_plans
TV_DAILY_CAP=15
TV_TELEGRAM_GRADES=A,B,C
# 0 = no automatic /tv runs: every alert still gets a plan file (scanner + rule legs)
TV_RUN_CLAUDE=1
# 0 = no "📐 levels" message after each alert
TV_LEVELS_TELEGRAM=1
# how often the worker checks the scanner database, and how long it waits after a scan is written
TV_POLL_SECONDS=10
TV_SETTLE_SECONDS=5
# $ you are willing to lose at the stop on one trade (the levels message sizes positions for it)
TV_RISK_USD=50
# Position sizing from the crypto-risk-app dashboard's database (read-only)
# risk per trade in % of the futures wallet balance; TV_RISK_USD above is only the fallback
TV_RISK_PCT=1
# halve the risk when the account is this % below its transfer-adjusted peak (0 = off)
TV_DRAWDOWN_HALVE_PCT=10
TV_DRAWDOWN_WINDOW_DAYS=30
# caps shown in the levels message against your real open positions
TV_MAX_OPEN=3
TV_MAX_SAME_DIRECTION=2
TV_RISK_PG_CONTAINER=crypto-risk-app-postgres-1
TV_RISK_PG_DB=crypto_risk
TV_RISK_PG_USER=crypto_risk_app
